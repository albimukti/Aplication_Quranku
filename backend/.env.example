# ==========================================
# Quranku Backend Environment Variables
# ==========================================

# Port (Local server)
PORT=8080

# JWT Secret
JWT_SECRET=quranku_super_secret_key_2026

# ==========================================
# Vercel Storage: Postgres (Neon)
# ==========================================
# Variabel di bawah ini OTOMATIS terisi jika Anda menghubungkan 
# Vercel Postgres melalui tab "Storage" di dashboard Vercel:
#
# POSTGRES_URL=postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require
# DATABASE_URL=postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require
# POSTGRES_HOST=ep-xxx.us-east-1.postgres.vercel-storage.com
# POSTGRES_PORT=5432
# POSTGRES_USER=default
# POSTGRES_PASSWORD=xxx
# POSTGRES_DATABASE=verceldb
# DB_SSLMODE=require

# ==========================================
# Vercel Storage: KV (Redis Upstash) - Opsional
# ==========================================
# Variabel di bawah ini OTOMATIS terisi jika Anda membuat Vercel KV:
#
# KV_URL=rediss://default:xxx@xxx.upstash.io:6379
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
